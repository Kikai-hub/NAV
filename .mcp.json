{
  "mcpServers": {
    "unityMCP": {
      "command": "uvx",
      "args": ["--offline", "--from", "mcpforunityserver", "mcp-for-unity", "--transport", "stdio"]
    },
    "blender": {
      "command": "uvx",
      "args": ["--python", "3.11", "blender-mcp"],
      "env": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "UV_PYTHON_PREFERENCE": "only-managed",
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
