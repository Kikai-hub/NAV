@import url("unity-theme://default");

/* NAV: Kurale (Google Fonts, SIL OFL - Art/Fonts/Kurale-OFL.txt) for every panel - has Cyrillic. */
:root {
    -unity-font-definition: url("project://database/Assets/NAV/Art/Fonts/Kurale%20SDF.asset");
}

/* NAV: dropdown popups (they open on the panel root, outside every window's own style sheet)
   in the wood-and-gold look of the UI kit. */
.unity-base-dropdown {
    -unity-font-definition: url("project://database/Assets/NAV/Art/Fonts/Kurale%20SDF.asset");
}

.unity-base-dropdown__container-outer {
    background-color: rgb(38, 28, 20);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(196, 148, 60);
    border-right-color: rgb(196, 148, 60);
    border-top-color: rgb(196, 148, 60);
    border-bottom-color: rgb(196, 148, 60);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.unity-base-dropdown__container-inner {
    background-color: rgb(38, 28, 20);
}

.unity-base-dropdown__item {
    color: rgb(235, 220, 190);
    background-color: rgba(0, 0, 0, 0);
}

.unity-base-dropdown .unity-base-dropdown__item:hover,
.unity-base-dropdown .unity-base-dropdown__item:focus,
.unity-base-dropdown .unity-base-dropdown__item:hover:checked {
    background-color: rgb(120, 78, 24);
    color: rgb(255, 236, 180);
}

.unity-base-dropdown__item:checked {
    background-color: rgba(0, 0, 0, 0);
}

.unity-base-dropdown__label {
    color: rgb(235, 220, 190);
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgb(226, 176, 74);
}
