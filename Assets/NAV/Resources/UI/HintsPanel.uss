/* First-steps hints (HintsUI): a small wooden card on the left, below the hotbar. Loaded from
   Resources (UI/HintsPanel) because the panel builds itself in code - no scene wiring. */

@import url("../../Scripts/UI/NAVTheme.uss");

.hint-card {
    position: absolute;
    left: 18px;
    top: 112px;
    width: 340px;
    padding: 14px 18px 14px 18px;
    margin-top: 0;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.35s;
    translate: -24px 0;
}

.hint-card--shown {
    opacity: 1;
    translate: 0 0;
}

.hint-card__header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.hint-card__title {
    font-size: 14px;
    color: rgb(226, 176, 74);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.hint-card__count {
    font-size: 12px;
    color: rgb(190, 170, 130);
}

.hint-card__text {
    font-size: 15px;
    white-space: normal;
    color: rgb(240, 226, 190);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.hint-card--done .hint-card__text {
    color: rgb(170, 220, 140);
}
