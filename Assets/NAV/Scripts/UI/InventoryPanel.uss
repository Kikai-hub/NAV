/* Inventory window - the frame, title, slots and tooltip come from NAVTheme.uss. */

.inventory-root {
    position: absolute;
    left: 24px;
    top: 0;
    bottom: 0;
    align-items: flex-start;
    justify-content: center;
}

/* 6 columns of 52 (slot 56 with -2 side margins) = 312. */
.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 312px;
}

.inventory-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.inventory-footer__icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
    background-image: url("../../Art/UI/Kit/IconWeight.png");
    -unity-background-scale-mode: scale-to-fit;
}

.inventory-weight {
    font-size: 13px;
    margin-right: 10px;
    min-width: 96px;
}

.inventory-weight--overloaded {
    color: rgb(225, 95, 70);
    -unity-font-style: bold;
}

.inventory-footer__bar {
    flex-grow: 1;
}

/* Stack being dragged - a slot frame following the cursor. */
.inventory-drag-ghost {
    position: absolute;
    width: 46px;
    height: 44px;
    opacity: 0.9;
    background-image: url("../../Art/UI/Kit/Slot.png");
    -unity-background-scale-mode: stretch-to-fill;
}
