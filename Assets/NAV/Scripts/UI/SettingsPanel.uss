/* Settings window - frame, title, buttons and scrollbar from NAVTheme.uss; sliders, toggles,
   dropdowns and key buttons re-skinned with the UI kit. */

.settings-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 8, 6, 0.78);
}

.settings-panel {
    width: 740px;
    height: 590px;
    max-width: 94%;
    max-height: 92%;
}

/* --- Tabs: kit buttons; the open tab glows --- */

.settings-tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 8px;
}

.settings-tab {
    min-width: 0;
    width: 170px;
    height: 44px;
    margin: 0 2px;
    font-size: 16px;
}

.settings-tab--active {
    background-image: url("../../Art/UI/Kit/ButtonHover.png");
    color: rgb(255, 236, 180);
}

/* --- Page: a darker inset with rows --- */

.settings-page {
    flex-grow: 1;
    background-color: rgba(18, 12, 8, 0.45);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(176, 132, 52, 0.45);
    border-right-color: rgba(176, 132, 52, 0.45);
    border-top-color: rgba(176, 132, 52, 0.45);
    border-bottom-color: rgba(176, 132, 52, 0.45);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding: 8px 12px;
}

.settings-section {
    color: rgb(226, 176, 74);
    font-size: 15px;
    -unity-font-style: bold;
    margin: 10px 0 4px 0;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(226, 176, 74, 0.5);
}

.settings-row {
    flex-direction: row;
    align-items: center;
    min-height: 38px;
    padding: 2px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(120, 90, 50, 0.3);
}

.settings-row__label {
    width: 230px;
    color: rgb(235, 220, 190);
    font-size: 15px;
}

.settings-row__control {
    flex-grow: 1;
    margin: 0;
}

.settings-row__value {
    width: 64px;
    color: rgb(214, 196, 160);
    font-size: 14px;
    -unity-text-align: middle-right;
}

/* Slider: the small bar as the track, a gold-and-wood thumb. */
.settings-row .unity-base-slider__tracker {
    height: 16px;
    margin-top: -8px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("../../Art/UI/Kit/BarSmall.png");
    -unity-slice-left: 26;
    -unity-slice-right: 26;
    -unity-slice-scale: 0.36px;
}

.settings-row .unity-base-slider__dragger {
    width: 14px;
    height: 26px;
    margin-top: -13px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("../../Art/UI/Kit/ScrollThumb.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.settings-row .unity-base-slider__dragger-border {
    display: none;
}

/* Toggle: a small kit square, gold tick when on. */
.settings-row .unity-toggle__checkmark {
    width: 24px;
    height: 24px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("../../Art/UI/Kit/ButtonSquare.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.settings-row .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: url("../../Art/UI/Kit/SlotSelected.png");
}

/* Dropdown: the input strip. */
.settings-row .unity-base-popup-field__input {
    height: 32px;
    padding: 2px 30px 2px 12px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("../../Art/UI/Kit/InputField.png");
    -unity-slice-left: 26;
    -unity-slice-right: 44;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    -unity-slice-scale: 0.5px;
    color: rgb(240, 228, 200);
}

.settings-row .unity-base-popup-field__arrow {
    display: none;
}

/* Key binding buttons. */
.settings-key-button {
    min-width: 120px;
    height: 32px;
    margin: 0 4px 0 0;
    padding: 2px 14px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("../../Art/UI/Kit/InputField.png");
    -unity-slice-left: 26;
    -unity-slice-right: 44;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    -unity-slice-scale: 0.5px;
    color: rgb(240, 228, 200);
    font-size: 14px;
    -unity-font-style: bold;
}

.settings-key-button:hover {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 225, 160);
}

.settings-key-button--listening {
    -unity-background-image-tint-color: rgb(255, 190, 90);
    color: rgb(255, 225, 140);
}

.settings-hint {
    color: rgb(196, 178, 146);
    font-size: 12px;
    -unity-font-style: italic;
    white-space: normal;
    margin: 4px 0;
}

.settings-footer {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
}

.settings-button {
    width: 230px;
}
