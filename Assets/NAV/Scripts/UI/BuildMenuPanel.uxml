<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="NAVTheme.uss" />
    <Style src="BuildMenuPanel.uss" />
    <ui:VisualElement name="build-menu-root" class="build-root">
        <ui:VisualElement name="build-menu-panel" class="build-panel nav-window">
            <ui:Label text="Build" class="nav-title" />
            <ui:Label text="Click a piece to build it, or the hammer to demolish" class="build-hint nav-text" />
            <ui:VisualElement name="slot-container" class="build-grid" />
            <ui:VisualElement class="build-info-strip nav-parchment">
                <ui:Label name="info-label" text="" class="build-info" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
