/* Container window (chest / gravestone) - frame, title, slots and button come from
   NAVTheme.uss. */

.gravestone-root {
    position: absolute;
    right: 24px;
    top: 0;
    bottom: 0;
    align-items: flex-end;
    justify-content: center;
}

/* 6 columns, same as the inventory. */
.gravestone-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 312px;
}

.gravestone-move-all-button {
    align-self: center;
    width: 200px;
    margin-top: 12px;
}
