/* NAV UI theme - shared look for every window, built from the UI kit sprites in Art/UI/Kit
   (NAV > UI > Build UI Kit Sprites). Panels add these classes on top of their own layout
   classes. Sizes are reference units of NAV_PanelSettings (1200 wide); 9-slice borders are in
   texture pixels, shrunk with -unity-slice-scale. Text: light on wood, dark brown on parchment. */

/* --- Windows --- */

.nav-window {
    background-image: url("../../Art/UI/Kit/PanelWood.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-scale: 0.6px;
    padding: 34px 28px 26px 28px;
    margin-top: 26px;
}

.nav-window--parchment {
    background-image: url("../../Art/UI/Kit/PanelParchment.png");
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
}

/* A parchment area inside a window (recipe details, dialogs). */
.nav-parchment {
    background-image: url("../../Art/UI/Kit/DialogParchment.png");
    -unity-slice-left: 34;
    -unity-slice-right: 34;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 0.5px;
    padding: 18px 18px 14px 18px;
}

/* The title plaque sits on the window's top edge, centred (like the mockups). */
.nav-title {
    position: absolute;
    top: -27px;
    left: 50%;
    width: 250px;
    height: 52px;
    margin-left: -125px;
    background-image: url("../../Art/UI/Kit/TitlePlaque.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-text-align: middle-center;
    color: rgb(240, 226, 190);
    font-size: 21px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    padding-bottom: 4px;
}

.nav-divider {
    height: 12px;
    margin: 6px 0;
    background-image: url("../../Art/UI/Kit/Divider.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.nav-text {
    color: rgb(235, 220, 190);
}

.nav-text--dark {
    color: rgb(60, 40, 22);
}

/* --- Buttons --- (the sprites carry a transparent margin as wide as the hover glow) */

.nav-button {
    height: 54px;
    min-width: 150px;
    margin: 0;
    padding: 0 32px 3px 32px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("../../Art/UI/Kit/Button.png");
    -unity-slice-left: 57;
    -unity-slice-right: 57;
    -unity-slice-scale: 0.5px;
    color: rgb(240, 228, 200);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.nav-button:hover {
    background-image: url("../../Art/UI/Kit/ButtonHover.png");
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 236, 180);
}

.nav-button:active {
    background-image: url("../../Art/UI/Kit/ButtonPressed.png");
    background-color: rgba(0, 0, 0, 0);
}

.nav-button:disabled {
    background-image: url("../../Art/UI/Kit/ButtonDisabled.png");
    background-color: rgba(0, 0, 0, 0);
    color: rgb(170, 160, 145);
    opacity: 1;
}

.nav-button--danger {
    background-image: url("../../Art/UI/Kit/ButtonDanger.png");
}

/* --- Item slots --- (empty slots show the faint ornament; selected/held glows gold) */

.nav-slot {
    width: 56px;
    height: 53px;
    margin: -1px -2px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("../../Art/UI/Kit/Slot.png");
    -unity-background-scale-mode: stretch-to-fill;
    align-items: center;
    justify-content: center;
}

.nav-slot--empty {
    background-image: url("../../Art/UI/Kit/SlotOrnament.png");
}

.nav-slot--selected {
    background-image: url("../../Art/UI/Kit/SlotSelected.png");
}

.nav-slot__icon {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
}

.nav-slot__quantity {
    position: absolute;
    right: 8px;
    bottom: 5px;
    color: rgb(245, 235, 215);
    font-size: 11px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.9);
}

/* --- Item tooltip (parchment card) --- */

.nav-tooltip {
    position: absolute;
    width: 230px;
    padding: 16px 18px 14px 18px;
    background-image: url("../../Art/UI/Kit/Tooltip.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-scale: 0.45px;
}

.nav-tooltip__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.nav-tooltip__icon {
    width: 34px;
    height: 34px;
    margin-right: 8px;
    background-image: url("../../Art/UI/Kit/Slot.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.nav-tooltip__icon-image {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.nav-tooltip__name {
    color: rgb(60, 36, 18);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

.nav-tooltip__description {
    color: rgb(75, 52, 30);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 4px;
}

.nav-tooltip__line {
    color: rgb(75, 52, 30);
    font-size: 11px;
    -unity-font-style: bold;
}

.nav-tooltip__hint {
    color: rgb(110, 75, 40);
    font-size: 10px;
    -unity-font-style: italic;
    margin-top: 4px;
}

/* --- Small bar (carry weight) --- */

.nav-bar-small {
    height: 16px;
    background-image: url("../../Art/UI/Kit/BarSmall.png");
    -unity-slice-left: 26;
    -unity-slice-right: 26;
    -unity-slice-scale: 0.36px;
}

.nav-bar-small__groove {
    position: absolute;
    left: 9px;
    right: 9px;
    top: 4px;
    bottom: 4px;
    overflow: hidden;
}

.nav-bar-small__fill {
    height: 100%;
    background-image: url("../../Art/UI/Kit/FillGold.png");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 0.2px;
}

.nav-bar-small__fill--over {
    background-image: url("../../Art/UI/Kit/FillRed.png");
}

/* --- Scrollbars (any ScrollView inside a themed window) --- */

.nav-window .unity-scroller--vertical {
    width: 15px;
    margin-left: 4px;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.nav-window .unity-scroller--vertical .unity-scroller__low-button,
.nav-window .unity-scroller--vertical .unity-scroller__high-button {
    display: flex;
    width: 15px;
    height: 15px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.nav-window .unity-scroller--vertical .unity-scroller__low-button {
    background-image: url("../../Art/UI/Kit/ScrollUp.png");
}

.nav-window .unity-scroller--vertical .unity-scroller__high-button {
    background-image: url("../../Art/UI/Kit/ScrollDown.png");
}

.nav-window .unity-scroller--vertical .unity-repeat-button__arrow,
.nav-window .unity-scroller--vertical .unity-scroller__low-button > *,
.nav-window .unity-scroller--vertical .unity-scroller__high-button > * {
    display: none;
}

.nav-window .unity-scroller--vertical .unity-base-slider--vertical {
    margin-top: 0;
    margin-bottom: 0;
    width: 15px;
}

.nav-window .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("../../Art/UI/Kit/ScrollTrack.png");
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.3px;
}

.nav-window .unity-scroller--vertical .unity-base-slider__dragger {
    left: 2px;
    width: 11px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("../../Art/UI/Kit/ScrollThumb.png");
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    -unity-slice-scale: 0.32px;
}

/* --- Text input (TextField with the nav-input class) --- */

.nav-input {
    margin: 0;
}

.nav-input .unity-base-text-field__input {
    height: 38px;
    padding: 4px 30px 4px 14px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("../../Art/UI/Kit/InputField.png");
    -unity-slice-left: 26;
    -unity-slice-right: 44;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    -unity-slice-scale: 0.6px;
    color: rgb(240, 228, 200);
    font-size: 15px;
    --unity-cursor-color: rgb(240, 210, 140);
    --unity-selection-color: rgba(200, 150, 60, 0.5);
}
