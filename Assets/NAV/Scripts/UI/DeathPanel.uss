/* Death screen - a dark red veil, the title in the logo's style and a kit button. */

.death-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(26, 4, 3, 0.72);
}

.death-panel {
    align-items: center;
}

.death-title {
    font-size: 76px;
    color: rgb(184, 38, 26);
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(226, 176, 74);
    text-shadow: 3px 4px 6px rgba(0, 0, 0, 0.85);
    letter-spacing: 4px;
}

.death-divider {
    width: 360px;
}

.death-hint {
    font-size: 16px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    margin: 4px 0 22px 0;
}

.death-button {
    width: 260px;
    height: 56px;
    font-size: 20px;
}
