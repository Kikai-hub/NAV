/* Build menu - takes the inventory's place while building; frame and title from NAVTheme.uss,
   slots drawn with the same kit sprites as .nav-slot. */

.build-root {
    position: absolute;
    left: 24px;
    top: 0;
    bottom: 0;
    align-items: flex-start;
    justify-content: center;
}

.build-hint {
    font-size: 12px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

/* 6 columns, like the inventory. */
.build-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 312px;
}

.build-slot {
    width: 56px;
    height: 53px;
    margin: -1px -2px;
    background-image: url("../../Art/UI/Kit/Slot.png");
    -unity-background-scale-mode: stretch-to-fill;
    align-items: center;
    justify-content: center;
}

.build-slot:hover {
    -unity-background-image-tint-color: rgb(255, 235, 200);
}

.build-slot--selected {
    background-image: url("../../Art/UI/Kit/SlotSelected.png");
}

.build-slot__icon {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
}

.build-slot__name {
    color: rgb(235, 220, 190);
    font-size: 9px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Demolish: the same slot, reddened. */
.build-slot--demolish {
    -unity-background-image-tint-color: rgb(255, 150, 130);
}

.build-slot--demolish:hover {
    -unity-background-image-tint-color: rgb(255, 180, 160);
}

.build-slot--unaffordable .build-slot__icon {
    opacity: 0.35;
}

.build-info-strip {
    margin-top: 10px;
    width: 312px;
    min-height: 54px;
}

.build-info {
    color: rgb(64, 40, 20);
    font-size: 13px;
    white-space: normal;
}

.build-info--short {
    color: rgb(165, 45, 30);
}
