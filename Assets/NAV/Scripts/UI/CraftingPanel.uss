.crafting-root {
    position: absolute;
    right: 24px;
    top: 0;
    bottom: 0;
    align-items: flex-end;
    justify-content: center;
}

.crafting-panel {
    background-color: rgb(43, 33, 24);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(139, 105, 20);
    border-right-color: rgb(139, 105, 20);
    border-top-color: rgb(139, 105, 20);
    border-bottom-color: rgb(139, 105, 20);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 16px;
    width: 560px;
}

.crafting-title {
    color: rgb(230, 210, 160);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.crafting-body {
    flex-direction: row;
    height: 380px;
}

/* --- Left column: tab header + scrollable recipe list --- */

.crafting-sidebar {
    width: 170px;
    flex-direction: column;
    margin-right: 14px;
    padding-right: 12px;
    border-right-width: 2px;
    border-right-color: rgb(139, 105, 20);
}

.crafting-tab {
    color: rgb(230, 210, 160);
    background-color: rgb(61, 48, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(139, 105, 20);
    border-right-color: rgb(139, 105, 20);
    border-top-color: rgb(139, 105, 20);
    border-bottom-color: rgb(139, 105, 20);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding: 4px 12px;
    margin-bottom: 8px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    align-self: flex-start;
}

.recipe-list {
    flex-grow: 1;
}

.recipe-list-item {
    flex-direction: row;
    align-items: center;
    padding: 6px;
    margin-bottom: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.recipe-list-item:hover {
    background-color: rgb(61, 48, 35);
}

.recipe-list-item--selected {
    background-color: rgb(120, 78, 24);
}

.recipe-list-item--unaffordable .recipe-list-item__name {
    color: rgb(150, 135, 115);
}

.recipe-list-item__icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    background-color: rgb(61, 48, 35);
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-list-item__name {
    color: rgb(230, 215, 190);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

/* --- Right column: selected recipe detail --- */

.recipe-detail {
    flex-grow: 1;
    flex-direction: column;
}

.recipe-detail__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.recipe-detail__icon {
    width: 56px;
    height: 56px;
    margin-right: 12px;
    background-color: rgb(61, 48, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(139, 105, 20);
    border-right-color: rgb(139, 105, 20);
    border-top-color: rgb(139, 105, 20);
    border-bottom-color: rgb(139, 105, 20);
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-detail__name {
    color: rgb(240, 200, 120);
    font-size: 22px;
    -unity-font-style: bold;
}

.recipe-detail__description {
    color: rgb(200, 188, 168);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 10px;
}

.recipe-detail__stats {
    flex-direction: column;
    margin-bottom: 6px;
}

.recipe-detail__stat-row {
    flex-direction: row;
    justify-content: space-between;
    max-width: 220px;
    margin-bottom: 2px;
}

.recipe-detail__stat-label {
    color: rgb(190, 175, 150);
    font-size: 13px;
}

.recipe-detail__stat-value {
    color: rgb(230, 215, 190);
    font-size: 13px;
    -unity-font-style: bold;
}

.recipe-detail__requirement {
    color: rgb(140, 190, 150);
    font-size: 12px;
    -unity-font-style: italic;
    margin-bottom: 6px;
    display: none;
}

.recipe-detail__requirement--missing {
    color: rgb(220, 90, 70);
}

.recipe-detail__placeholder {
    color: rgb(150, 135, 115);
    font-size: 14px;
    -unity-font-style: italic;
}

.recipe-detail__ingredients {
    flex-direction: row;
    flex-grow: 1;
    align-items: flex-start;
}

.ingredient-slot {
    width: 52px;
    height: 52px;
    margin-right: 8px;
    background-color: rgb(61, 48, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(90, 70, 50);
    border-right-color: rgb(90, 70, 50);
    border-top-color: rgb(90, 70, 50);
    border-bottom-color: rgb(90, 70, 50);
    align-items: center;
    justify-content: center;
    position: relative;
}

.ingredient-slot__icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.ingredient-slot__amount {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    color: rgb(140, 220, 140);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: lower-center;
}

.ingredient-slot__amount--insufficient {
    color: rgb(220, 90, 70);
}

.recipe-detail__craft-button {
    height: 36px;
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 8px;
    background-color: rgb(120, 78, 24);
    color: rgb(240, 230, 210);
    border-left-color: rgb(139, 105, 20);
    border-right-color: rgb(139, 105, 20);
    border-top-color: rgb(139, 105, 20);
    border-bottom-color: rgb(139, 105, 20);
}
