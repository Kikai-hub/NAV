/* Crafting window - frame, title, slots, button, parchment and scrollbar come from
   NAVTheme.uss. Recipe list on the wood (light text), details on parchment (dark text). */

.crafting-root {
    position: absolute;
    right: 24px;
    top: 0;
    bottom: 0;
    align-items: flex-end;
    justify-content: center;
}

.crafting-panel {
    width: 620px;
}

.crafting-body {
    flex-direction: row;
    height: 390px;
}

/* --- Left: scrollable recipe list --- */

.crafting-sidebar {
    width: 220px;
    margin-right: 14px;
}

.recipe-list {
    flex-grow: 1;
}

.recipe-list-empty {
    color: rgb(190, 175, 150);
    font-size: 12px;
    white-space: normal;
    margin-top: 8px;
}

.recipe-list-item {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px 3px 3px;
    margin-bottom: 3px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: rgba(20, 13, 8, 0.35);
}

.recipe-list-item:hover {
    background-color: rgba(120, 82, 34, 0.45);
}

.recipe-list-item--selected {
    background-color: rgba(120, 78, 24, 0.6);
    border-left-color: rgb(232, 182, 72);
    border-right-color: rgb(232, 182, 72);
    border-top-color: rgb(232, 182, 72);
    border-bottom-color: rgb(232, 182, 72);
}

.recipe-list-item--unaffordable .recipe-list-item__name {
    color: rgb(160, 145, 125);
}

.recipe-list-item__icon {
    width: 36px;
    height: 36px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-list-item__name {
    color: rgb(238, 224, 196);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

/* --- Right: selected recipe on parchment --- */

.recipe-detail {
    flex-grow: 1;
    flex-direction: column;
}

.recipe-detail__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.recipe-detail__icon-frame {
    width: 64px;
    height: 60px;
    margin-right: 10px;
}

.recipe-detail__icon {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-detail__name {
    color: rgb(64, 36, 16);
    font-size: 21px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

.recipe-detail__description {
    color: rgb(78, 54, 30);
    font-size: 13px;
    white-space: normal;
}

.recipe-detail__stats {
    flex-direction: column;
    margin-bottom: 4px;
}

.recipe-detail__stat-row {
    flex-direction: row;
    justify-content: space-between;
    max-width: 220px;
    margin-bottom: 1px;
}

.recipe-detail__stat-label {
    color: rgb(95, 68, 40);
    font-size: 12px;
}

.recipe-detail__stat-value {
    color: rgb(60, 36, 16);
    font-size: 12px;
    -unity-font-style: bold;
}

.recipe-detail__requirement {
    color: rgb(50, 110, 55);
    font-size: 12px;
    -unity-font-style: italic;
    margin-bottom: 4px;
    display: none;
}

.recipe-detail__requirement--missing {
    color: rgb(170, 45, 30);
}

.recipe-detail__placeholder {
    color: rgb(110, 85, 60);
    font-size: 14px;
    -unity-font-style: italic;
}

.recipe-detail__section {
    color: rgb(95, 68, 40);
    font-size: 12px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.recipe-detail__ingredients {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    align-items: flex-start;
}

.ingredient-slot {
    position: relative;
}

.ingredient-slot__amount {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    color: rgb(150, 230, 140);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: lower-center;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.95);
}

.ingredient-slot__amount--insufficient {
    color: rgb(240, 100, 80);
}

.recipe-detail__craft-button {
    align-self: center;
    width: 210px;
    margin-top: 6px;
}
