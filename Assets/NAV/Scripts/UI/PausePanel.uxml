<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="NAVTheme.uss" />
    <Style src="PausePanel.uss" />
    <ui:VisualElement name="pause-root" class="pause-root">
        <ui:VisualElement class="pause-panel nav-window">
            <ui:Label text="Paused" class="nav-title" />
            <ui:Button name="resume-button" text="Resume" class="pause-button nav-button" />
            <ui:Button name="settings-button" text="Settings" class="pause-button nav-button" />
            <ui:Button name="main-menu-button" text="Leave to Main Menu" class="pause-button nav-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
