<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="NAVTheme.uss" />
    <Style src="CraftingPanel.uss" />
    <ui:VisualElement name="crafting-root" class="crafting-root">
        <ui:VisualElement name="crafting-panel" class="crafting-panel nav-window">
            <ui:Label name="crafting-title" text="Crafting" class="nav-title" />
            <ui:VisualElement class="crafting-body">
                <ui:VisualElement class="crafting-sidebar">
                    <ui:ScrollView name="recipe-list" class="recipe-list" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                </ui:VisualElement>
                <ui:VisualElement name="recipe-detail" class="recipe-detail nav-parchment">
                    <ui:VisualElement class="recipe-detail__header">
                        <ui:VisualElement class="recipe-detail__icon-frame nav-slot">
                            <ui:VisualElement name="detail-icon" class="recipe-detail__icon" />
                        </ui:VisualElement>
                        <ui:Label name="detail-name" class="recipe-detail__name" />
                    </ui:VisualElement>
                    <ui:Label name="detail-description" class="recipe-detail__description" />
                    <ui:VisualElement class="nav-divider" />
                    <ui:VisualElement name="detail-stats" class="recipe-detail__stats" />
                    <ui:Label name="detail-requirement" class="recipe-detail__requirement" />
                    <ui:Label text="Requires" class="recipe-detail__section" />
                    <ui:VisualElement name="detail-ingredients" class="recipe-detail__ingredients" />
                    <ui:Button name="detail-craft-button" text="Craft" class="recipe-detail__craft-button nav-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
