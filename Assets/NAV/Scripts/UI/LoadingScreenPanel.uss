/* Loading screen - the logo, "Loading..." and the kit's horizontal bar (same frame as the HUD
   stamina bar) with a gold fill and a sweeping shimmer (LoadingScreenUIController). */

.loading-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(18, 14, 10);
}

.loading-logo {
    width: 360px;
    height: 159px;
    margin-bottom: 10px;
    background-image: url("../../Art/UI/Kit/Logo.png");
    -unity-background-scale-mode: scale-to-fit;
}

.loading-label {
    color: rgb(238, 222, 186);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    min-width: 110px;
    -unity-text-align: middle-left;
}

.loading-progress-track {
    width: 420px;
    height: 40px;
    background-image: url("../../Art/UI/Kit/BarHorizontal.png");
    -unity-slice-left: 75;
    -unity-slice-right: 75;
    -unity-slice-scale: 0.46px;
}

/* The groove inside the frame (same proportions as the HUD stamina bar). */
.loading-progress-groove {
    position: absolute;
    left: 44px;
    right: 43px;
    top: 10px;
    bottom: 12px;
    overflow: hidden;
}

.loading-progress-fill {
    width: 0%;
    height: 100%;
    background-image: url("../../Art/UI/Kit/FillGold.png");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 0.3px;
}

/* Continuously sweeps left-to-right across the groove (see LoadingScreenUIController.Update)
   so the bar visibly reads as "working" even while progress is stuck at Unity's 0.9 cap. */
.loading-progress-shimmer {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 20%;
    background-color: rgba(255, 236, 180, 0.3);
}
