<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="NAVTheme.uss" />
    <Style src="DeathPanel.uss" />
    <ui:VisualElement name="death-root" class="death-root">
        <ui:VisualElement class="death-panel">
            <ui:Label text="You Died" class="death-title" />
            <ui:VisualElement class="death-divider nav-divider" />
            <ui:Label text="Your belongings wait at your gravestone." class="death-hint nav-text" />
            <ui:Button name="respawn-button" text="Respawn" class="death-button nav-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
