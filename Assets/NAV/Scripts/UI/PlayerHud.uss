.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* --- Hotbar: top-left, horizontal, 7 slots --- */

.hotbar-container {
    position: absolute;
    top: 24px;
    left: 24px;
    flex-direction: row;
}

.hotbar-slot {
    width: 56px;
    height: 56px;
    margin: 4px;
    background-color: rgb(61, 48, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(90, 70, 50);
    border-right-color: rgb(90, 70, 50);
    border-top-color: rgb(90, 70, 50);
    border-bottom-color: rgb(90, 70, 50);
    align-items: center;
    justify-content: center;
    position: relative;
}

.hotbar-slot__icon {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
}

.hotbar-slot__quantity {
    position: absolute;
    right: 2px;
    bottom: 2px;
    color: rgb(240, 230, 210);
    font-size: 11px;
    -unity-font-style: bold;
}

/* --- Health: bottom-left, vertical fill --- */

.health-bar {
    position: absolute;
    bottom: 24px;
    left: 24px;
    width: 32px;
    height: 160px;
    background-color: rgb(43, 33, 24);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(139, 105, 20);
    border-right-color: rgb(139, 105, 20);
    border-top-color: rgb(139, 105, 20);
    border-bottom-color: rgb(139, 105, 20);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    justify-content: flex-end;
    overflow: hidden;
}

.health-bar__fill {
    width: 100%;
    height: 100%;
    background-color: rgb(190, 40, 40);
}

/* --- Stamina: centered, same bottom level as health, horizontal fill. Stays visible from
   the moment stamina starts draining until it's fully back to max (not just while actively
   draining), and fades in/out via opacity rather than snapping - PlayerHudController only
   ever sets opacity, never display, so this transition is what animates it. --- */

.stamina-bar {
    position: absolute;
    bottom: 24px;
    left: 50%;
    margin-left: -120px;
    width: 240px;
    height: 22px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
    background-color: rgb(43, 33, 24);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(139, 105, 20);
    border-right-color: rgb(139, 105, 20);
    border-top-color: rgb(139, 105, 20);
    border-bottom-color: rgb(139, 105, 20);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    justify-content: flex-start;
    overflow: hidden;
}

.stamina-bar__fill {
    width: 100%;
    height: 100%;
    background-color: rgb(180, 170, 60);
}

/* --- Crosshair: dead center of the screen, a ring + a dot so it stays readable against any
   background. Color swaps by state (set from code via the crosshair--* classes below) instead
   of the ring/dot themselves moving or resizing, so the "am I aiming at something" read stays
   in one fixed spot. --- */

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
}

.crosshair-ring {
    position: absolute;
    left: -12px;
    top: -12px;
    width: 24px;
    height: 24px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(0, 0, 0, 0);
}

/* Fixed small white center dot, independent of aim state - only the ring around it changes
   color. Sized well under the ring (~1.5px vs. the ring's 24px) so it reads as a precise aim
   point rather than a blob. */
.crosshair-dot {
    position: absolute;
    left: -0.75px;
    top: -0.75px;
    width: 1.5px;
    height: 1.5px;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 0.75px;
    border-top-right-radius: 0.75px;
    border-bottom-left-radius: 0.75px;
    border-bottom-right-radius: 0.75px;
}

/* State colors below apply only to the ring - the dot always stays white (see .crosshair-dot). */

.crosshair-ring.crosshair--neutral {
    border-left-color: rgb(230, 210, 160);
    border-right-color: rgb(230, 210, 160);
    border-top-color: rgb(230, 210, 160);
    border-bottom-color: rgb(230, 210, 160);
}

/* Interact (gather/pickup/workbench/demolish) - matches the panels' gold accent. */
.crosshair-ring.crosshair--interact {
    border-left-color: rgb(255, 210, 90);
    border-right-color: rgb(255, 210, 90);
    border-top-color: rgb(255, 210, 90);
    border-bottom-color: rgb(255, 210, 90);
}

/* Attack (a live IDamageable is within weapon range). */
.crosshair-ring.crosshair--attack {
    border-left-color: rgb(220, 60, 60);
    border-right-color: rgb(220, 60, 60);
    border-top-color: rgb(220, 60, 60);
    border-bottom-color: rgb(220, 60, 60);
}

/* Build mode - valid placement. */
.crosshair-ring.crosshair--valid {
    border-left-color: rgb(100, 210, 100);
    border-right-color: rgb(100, 210, 100);
    border-top-color: rgb(100, 210, 100);
    border-bottom-color: rgb(100, 210, 100);
}

/* Build mode - invalid placement (out of range / can't afford). */
.crosshair-ring.crosshair--invalid {
    border-left-color: rgb(220, 60, 60);
    border-right-color: rgb(220, 60, 60);
    border-top-color: rgb(220, 60, 60);
    border-bottom-color: rgb(220, 60, 60);
}
