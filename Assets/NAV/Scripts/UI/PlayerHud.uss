/* HUD in the NAV UI kit style (Art/UI/Kit, cut from the developer's ChatGPT UI kit by
   NAV > UI > Build UI Kit Sprites). Sizes are in reference units of NAV_PanelSettings
   (1200 wide, scaled with the screen width); 9-slice borders are given in texture pixels and
   shrunk with -unity-slice-scale. */

.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* --- Hotbar: top-left - an ornamented cap, 6 slots, a cap --- */

.hotbar-container {
    position: absolute;
    top: 14px;
    left: 14px;
    flex-direction: row;
    align-items: center;
}

.hotbar-cap {
    width: 17px;
    height: 46px;
    -unity-background-scale-mode: stretch-to-fill;
}

.hotbar-cap--left {
    background-image: url("../../Art/UI/Kit/HotbarCapLeft.png");
}

.hotbar-cap--right {
    background-image: url("../../Art/UI/Kit/HotbarCapRight.png");
}

/* The slot sprites carry a transparent margin as wide as the selected slot's glow, so both
   states swap in place - the visible frame is ~90% of the element. */
.hotbar-slot {
    width: 54px;
    height: 51px;
    margin-left: -2px;
    margin-right: -2px;
    background-image: url("../../Art/UI/Kit/Slot.png");
    -unity-background-scale-mode: stretch-to-fill;
    align-items: center;
    justify-content: center;
}

.hotbar-slot--equipped {
    background-image: url("../../Art/UI/Kit/SlotSelected.png");
}

.hotbar-slot__icon {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
}

.hotbar-slot__quantity {
    position: absolute;
    right: 8px;
    bottom: 5px;
    color: rgb(245, 235, 215);
    font-size: 11px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.9);
}

.hotbar-slot__key {
    position: absolute;
    left: 8px;
    top: 4px;
    color: rgb(225, 205, 160);
    font-size: 10px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.9);
}

/* --- Health: bottom-left, vertical bar with diamond caps, fills from the bottom --- */

.health-bar {
    position: absolute;
    bottom: 14px;
    left: 16px;
    width: 36px;
    height: 200px;
    background-image: url("../../Art/UI/Kit/BarVertical.png");
    -unity-slice-top: 75;
    -unity-slice-bottom: 75;
    -unity-slice-scale: 0.42px;
}

.health-bar__groove {
    position: absolute;
    left: 11px;
    right: 11px;
    top: 37px;
    bottom: 37px;
    justify-content: flex-end;
    overflow: hidden;
}

.health-bar__fill {
    width: 100%;
    height: 100%;
    background-image: url("../../Art/UI/Kit/FillRed.png");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 0.3px;
}

/* --- Stamina: centered at the bottom; fades in while not full (PlayerHudController sets
   only opacity, this transition animates it). --- */

.stamina-bar {
    position: absolute;
    bottom: 14px;
    left: 50%;
    width: 290px;
    height: 30px;
    margin-left: -145px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
    background-image: url("../../Art/UI/Kit/BarHorizontal.png");
    -unity-slice-left: 75;
    -unity-slice-right: 75;
    -unity-slice-scale: 0.345px;
}

.stamina-bar__groove {
    position: absolute;
    left: 33px;
    right: 32px;
    top: 8px;
    bottom: 9px;
    overflow: hidden;
}

.stamina-bar__fill {
    width: 100%;
    height: 100%;
    background-image: url("../../Art/UI/Kit/FillGold.png");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 0.3px;
}

/* --- Active food: right of the health bar - round wooden slots; the gold ring drains as a
   timer (drawn by PlayerHudController over the ring). --- */

.food-container {
    position: absolute;
    bottom: 12px;
    left: 62px;
    flex-direction: row;
    align-items: flex-end;
}

.food-slot {
    width: 58px;
    height: 68px;
    margin-right: 4px;
    background-image: url("../../Art/UI/Kit/FoodSlot.png");
    -unity-background-scale-mode: stretch-to-fill;
    align-items: center;
    justify-content: center;
}

.food-slot__icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.food-slot__ring {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* --- Day sign: top-right birch-bark plank, "Day N · HH:MM" and the weather icon --- */

.day-sign {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 196px;
    height: 54px;
    background-image: url("../../Art/UI/Kit/DaySign.png");
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 18px;
    padding-right: 12px;
}

.clock-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: rgb(62, 40, 22);
    font-size: 15px;
    -unity-font-style: bold;
}

.clock-label--night {
    color: rgb(40, 50, 95);
}

.weather-icon {
    width: 30px;
    height: 30px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Interaction prompt under the crosshair: "[E] Pick up: Wood" on a dark plaque. */
.interact-prompt {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% 0;
    margin-top: 22px;
    padding: 3px 10px;
    background-color: rgba(24, 16, 10, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(176, 132, 52, 0.6);
    border-right-color: rgba(176, 132, 52, 0.6);
    border-top-color: rgba(176, 132, 52, 0.6);
    border-bottom-color: rgba(176, 132, 52, 0.6);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-text-align: middle-center;
    color: rgb(240, 230, 210);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.interact-prompt--hidden {
    display: none;
}

/* --- Crosshair: dead center of the screen, a ring + a dot so it stays readable against any
   background. Color swaps by state (set from code via the crosshair--* classes below) instead
   of the ring/dot themselves moving or resizing, so the "am I aiming at something" read stays
   in one fixed spot. --- */

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
}

.crosshair-ring {
    position: absolute;
    left: -12px;
    top: -12px;
    width: 24px;
    height: 24px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(0, 0, 0, 0);
}

/* Fixed small white center dot, independent of aim state - only the ring around it changes
   color. Sized well under the ring (~1.5px vs. the ring's 24px) so it reads as a precise aim
   point rather than a blob. */
.crosshair-dot {
    position: absolute;
    left: -0.75px;
    top: -0.75px;
    width: 1.5px;
    height: 1.5px;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 0.75px;
    border-top-right-radius: 0.75px;
    border-bottom-left-radius: 0.75px;
    border-bottom-right-radius: 0.75px;
}

/* State colors below apply only to the ring - the dot always stays white (see .crosshair-dot). */

.crosshair-ring.crosshair--neutral {
    border-left-color: rgb(230, 210, 160);
    border-right-color: rgb(230, 210, 160);
    border-top-color: rgb(230, 210, 160);
    border-bottom-color: rgb(230, 210, 160);
}

/* Interact (gather/pickup/workbench/demolish) - matches the panels' gold accent. */
.crosshair-ring.crosshair--interact {
    border-left-color: rgb(255, 210, 90);
    border-right-color: rgb(255, 210, 90);
    border-top-color: rgb(255, 210, 90);
    border-bottom-color: rgb(255, 210, 90);
}

/* Attack (a live IDamageable is within weapon range). */
.crosshair-ring.crosshair--attack {
    border-left-color: rgb(220, 60, 60);
    border-right-color: rgb(220, 60, 60);
    border-top-color: rgb(220, 60, 60);
    border-bottom-color: rgb(220, 60, 60);
}

/* Build mode - valid placement. */
.crosshair-ring.crosshair--valid {
    border-left-color: rgb(100, 210, 100);
    border-right-color: rgb(100, 210, 100);
    border-top-color: rgb(100, 210, 100);
    border-bottom-color: rgb(100, 210, 100);
}

/* Build mode - invalid placement (out of range / can't afford). */
.crosshair-ring.crosshair--invalid {
    border-left-color: rgb(220, 60, 60);
    border-right-color: rgb(220, 60, 60);
    border-top-color: rgb(220, 60, 60);
    border-bottom-color: rgb(220, 60, 60);
}
