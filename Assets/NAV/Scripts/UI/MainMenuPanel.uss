.main-menu-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(20, 15, 10);
}

.main-menu-panel {
    background-color: rgb(43, 33, 24);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(139, 105, 20);
    border-right-color: rgb(139, 105, 20);
    border-top-color: rgb(139, 105, 20);
    border-bottom-color: rgb(139, 105, 20);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 32px 48px;
    align-items: center;
    min-width: 320px;
}

.main-menu-title {
    color: rgb(230, 210, 160);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.main-menu-subtitle {
    color: rgb(190, 175, 150);
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.main-menu-button {
    width: 200px;
    height: 44px;
    margin: 6px 0;
    background-color: rgb(61, 48, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(139, 105, 20);
    border-right-color: rgb(139, 105, 20);
    border-top-color: rgb(139, 105, 20);
    border-bottom-color: rgb(139, 105, 20);
    color: rgb(230, 210, 160);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.main-menu-button:hover {
    background-color: rgb(80, 63, 45);
}

.load-game-panel {
    min-width: 420px;
}

.create-world-panel {
    min-width: 360px;
}

.create-world-field {
    width: 100%;
    margin-bottom: 14px;
}

.create-world-field__label {
    color: rgb(190, 175, 150);
    font-size: 13px;
    margin-bottom: 4px;
}

.create-world-field__input {
    background-color: rgb(30, 23, 17);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(139, 105, 20);
    border-right-color: rgb(139, 105, 20);
    border-top-color: rgb(139, 105, 20);
    border-bottom-color: rgb(139, 105, 20);
    color: rgb(230, 210, 160);
    font-size: 14px;
    padding: 4px 6px;
}

.create-world-seed-row {
    flex-direction: row;
}

.create-world-seed-row__input {
    flex-grow: 1;
    margin-right: 6px;
}

.create-world-seed-row__randomize {
    width: 90px;
    height: auto;
    margin: 0;
    font-size: 12px;
}

.load-game-title {
    font-size: 30px;
}

.save-list {
    width: 100%;
    max-height: 320px;
    margin-bottom: 16px;
}

.save-list-item {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    margin-bottom: 6px;
    background-color: rgb(61, 48, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(139, 105, 20);
    border-right-color: rgb(139, 105, 20);
    border-top-color: rgb(139, 105, 20);
    border-bottom-color: rgb(139, 105, 20);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.save-list-item__info {
    flex-direction: column;
    flex-grow: 1;
}

.save-list-item__info:hover {
    opacity: 0.85;
}

.save-list-item__name {
    color: rgb(230, 210, 160);
    font-size: 15px;
    -unity-font-style: bold;
}

.save-list-item__date {
    color: rgb(190, 175, 150);
    font-size: 12px;
}

.save-list-item__delete-button {
    width: 28px;
    height: 28px;
    margin-left: 8px;
    padding: 0;
    background-color: rgb(90, 40, 32);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(139, 105, 20);
    border-right-color: rgb(139, 105, 20);
    border-top-color: rgb(139, 105, 20);
    border-bottom-color: rgb(139, 105, 20);
    color: rgb(230, 210, 160);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.save-list-item__delete-button:hover {
    background-color: rgb(130, 55, 42);
}

.save-list-empty {
    color: rgb(150, 135, 115);
    font-size: 14px;
    -unity-font-style: italic;
    margin-bottom: 16px;
    display: none;
}

.confirm-dialog-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
    display: none;
}

.confirm-dialog {
    background-color: rgb(43, 33, 24);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(139, 105, 20);
    border-right-color: rgb(139, 105, 20);
    border-top-color: rgb(139, 105, 20);
    border-bottom-color: rgb(139, 105, 20);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 24px 32px;
    min-width: 320px;
    align-items: center;
}

.confirm-dialog__message {
    color: rgb(230, 210, 160);
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    max-width: 320px;
}

.confirm-dialog__buttons {
    flex-direction: row;
}

.confirm-dialog__button {
    width: 130px;
    margin: 0 6px;
}

.confirm-dialog__button--danger {
    background-color: rgb(120, 40, 30);
    border-left-color: rgb(180, 60, 45);
    border-right-color: rgb(180, 60, 45);
    border-top-color: rgb(180, 60, 45);
    border-bottom-color: rgb(180, 60, 45);
}

.confirm-dialog__button--danger:hover {
    background-color: rgb(150, 55, 40);
}
