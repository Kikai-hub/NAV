/* Main menu, Create World, Load Game and the confirm dialog - windows, buttons and inputs come
   from NAVTheme.uss. Layout follows the developer's mockup: logo and a column of buttons on
   the left. The background is plain dark until the menu art (mockup without UI) exists. */

.main-menu-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(18, 14, 10);
}

/* --- Title screen --- */

.main-menu-panel {
    position: absolute;
    left: 70px;
    top: 50px;
    align-items: center;
}

.main-menu-logo {
    width: 420px;
    height: 186px;
    margin-bottom: 18px;
    background-image: url("../../Art/UI/Kit/Logo.png");
    -unity-background-scale-mode: scale-to-fit;
}

.main-menu-button {
    width: 310px;
    height: 72px;
    margin-bottom: 4px;
    font-size: 23px;
}

.main-menu-version {
    position: absolute;
    right: 18px;
    bottom: 12px;
    color: rgb(200, 170, 110);
    font-size: 12px;
}

/* --- Create World (parchment) --- */

.create-world-panel {
    width: 460px;
    display: none;
    align-items: stretch;
    padding: 46px 40px 30px 40px;
}

.create-world-field {
    margin-bottom: 14px;
    flex-shrink: 0;
}

.create-world-field__label {
    color: rgb(62, 38, 18);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.create-world-seed-row {
    flex-direction: row;
    align-items: center;
}

.create-world-seed-row__input {
    flex-grow: 1;
}

.create-world-seed-row__randomize {
    min-width: 0;
    width: 140px;
    height: 48px;
    margin-left: 8px;
    font-size: 14px;
    padding: 0 18px 2px 18px;
}

.create-world-button {
    align-self: center;
    width: 250px;
    margin-top: 10px;
    margin-bottom: 6px;
}

.create-world-back-button {
    align-self: center;
    width: 170px;
    height: 50px;
    font-size: 14px;
}

/* --- Create World: online options --- */

.create-world-online-toggle {
    margin-bottom: 8px;
    flex-shrink: 0;
}

.create-world-online-toggle > .unity-label {
    color: rgb(62, 38, 18);
    font-size: 16px;
    -unity-font-style: bold;
    min-width: 90px;
}

.create-world-online {
    display: none;
    flex-shrink: 0;
}

.create-world-online__row {
    flex-direction: row;
    flex-shrink: 0;
}

.create-world-online__half {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 6px;
}

.create-world-pvp {
    flex-shrink: 0;
    margin-bottom: 6px;
}

.create-world-pvp > .unity-radio-button-group__container,
.create-world-pvp #unity-radio-button-group__container {
    flex-direction: row;
    justify-content: space-between;
}

.create-world-pvp .unity-radio-button > .unity-label,
.create-world-pvp .unity-radio-button__label {
    color: rgb(62, 38, 18);
    font-size: 14px;
}

.create-world-status {
    color: rgb(120, 40, 20);
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

/* --- Multiplayer: server list --- */

.multiplayer-panel {
    width: 680px;
    display: none;
    height: 640px;
    max-height: 94%;
}

.multiplayer-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.multiplayer-row__label {
    width: 120px;
    font-size: 16px;
}

.multiplayer-row__input {
    flex-grow: 1;
}

.multiplayer-list-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    margin-bottom: 4px;
}

.multiplayer-list-header__title {
    font-size: 17px;
    -unity-font-style: bold;
}

.multiplayer-small-button {
    min-width: 0;
    width: 130px;
    height: 40px;
    font-size: 13px;
}

.room-list {
    flex-grow: 1;
    margin-bottom: 8px;
}

.room-list-empty {
    -unity-text-align: middle-center;
    font-size: 15px;
    margin-bottom: 8px;
}

.room-list-item {
    flex-direction: row;
    align-items: center;
    height: 58px;
    margin-bottom: 5px;
    padding-left: 18px;
    padding-right: 18px;
    background-image: url("../../Art/UI/Kit/InputField.png");
    -unity-slice-left: 26;
    -unity-slice-right: 44;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    -unity-slice-scale: 0.7px;
}

.room-list-item:hover {
    -unity-background-image-tint-color: rgb(255, 222, 160);
}

.room-list-item--selected {
    -unity-background-image-tint-color: rgb(255, 200, 120);
}

.room-list-item__info {
    flex-grow: 1;
}

.room-list-item__name {
    color: rgb(240, 228, 200);
    font-size: 16px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.room-list-item__details {
    color: rgb(196, 178, 146);
    font-size: 12px;
    margin: 0;
    padding: 0;
}

.room-list-item__players {
    color: rgb(222, 206, 172);
    font-size: 14px;
}

.multiplayer-status {
    -unity-text-align: middle-center;
    font-size: 14px;
    white-space: normal;
    min-height: 20px;
}

.multiplayer-buttons {
    flex-direction: row;
    justify-content: center;
}

.multiplayer-button {
    min-width: 0;
    width: 200px;
    margin: 0 6px;
}

/* --- Load Game --- */

.load-game-panel {
    width: 640px;
    display: none;
    height: 500px;
    max-height: 90%;
}

.save-list {
    flex-grow: 1;
    margin-bottom: 10px;
}

.save-list-item {
    flex-direction: row;
    align-items: center;
    height: 66px;
    margin-bottom: 6px;
    padding-left: 18px;
    padding-right: 34px;
    background-image: url("../../Art/UI/Kit/InputField.png");
    -unity-slice-left: 26;
    -unity-slice-right: 44;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    -unity-slice-scale: 0.7px;
}

.save-list-item:hover {
    -unity-background-image-tint-color: rgb(255, 222, 160);
}

.save-list-item__info {
    flex-grow: 1;
    height: 100%;
    justify-content: center;
}

.save-list-item__name {
    color: rgb(240, 228, 200);
    font-size: 17px;
    margin: 0;
    padding: 0;
    -unity-font-style: bold;
}

.save-list-item__seed {
    color: rgb(196, 178, 146);
    font-size: 12px;
    margin: 0;
    padding: 0;
}

.save-list-item__meta {
    position: absolute;
    right: 6px;
    top: 0;
    bottom: 0;
    align-items: flex-end;
    justify-content: center;
}

.save-list-item__date {
    color: rgb(222, 206, 172);
    font-size: 13px;
    margin: 0;
    padding: 0;
}

.save-list-item__badge {
    margin-top: 3px;
    padding: 0 9px 1px 9px;
    background-image: url("../../Art/UI/Kit/Badge.png");
    -unity-slice-left: 18;
    -unity-slice-right: 18;
    -unity-slice-scale: 0.5px;
    color: rgb(58, 34, 12);
    font-size: 10px;
    -unity-font-style: bold;
}

.save-list-item__delete-button {
    width: 30px;
    height: 30px;
    margin-left: 10px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("../../Art/UI/Kit/IconClose.png");
    -unity-background-scale-mode: scale-to-fit;
}

.save-list-item__delete-button:hover {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 170, 140);
}

.save-list-empty {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 60px;
    margin-bottom: 10px;
    display: none;
}

.save-list-empty__icon {
    width: 34px;
    height: 34px;
    margin-right: 10px;
    background-image: url("../../Art/UI/Kit/IconEmpty.png");
    -unity-background-scale-mode: scale-to-fit;
}

.save-list-empty__text {
    font-size: 17px;
}

.load-back-button {
    align-self: center;
    width: 180px;
}

/* --- Confirm dialog (parchment) --- */

.confirm-dialog-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
    display: none;
}

.confirm-dialog {
    width: 380px;
    margin-top: 0;
    padding: 30px 30px 22px 30px;
    align-items: center;
}

.confirm-dialog__message {
    color: rgb(62, 38, 18);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.confirm-dialog__buttons {
    flex-direction: row;
}

.confirm-dialog__button {
    min-width: 0;
    width: 150px;
    height: 44px;
    margin: 0 4px;
}
