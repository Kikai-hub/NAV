/* Pause window - frame, title and buttons from NAVTheme.uss. */

.pause-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 8, 6, 0.72);
}

.pause-panel {
    align-items: center;
    padding: 44px 40px 30px 40px;
}

.pause-button {
    width: 300px;
    height: 54px;
    margin-bottom: 8px;
    font-size: 19px;
}
