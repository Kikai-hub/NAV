/* End-of-demo screen - a dark forest veil, a gold title in the logo's style and kit buttons. */

@import url("NAVTheme.uss");

.demo-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 16, 10, 0.82);
}

.demo-panel {
    align-items: center;
    max-width: 720px;
    padding: 0 24px;
}

.demo-title {
    font-size: 56px;
    color: rgb(226, 176, 74);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(60, 32, 8);
    text-shadow: 3px 4px 6px rgba(0, 0, 0, 0.85);
    letter-spacing: 3px;
}

.demo-divider {
    width: 420px;
}

.demo-text {
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    margin: 4px 0 10px 0;
}

.demo-button {
    width: 300px;
    height: 52px;
    font-size: 20px;
    margin-top: 10px;
}

.demo-button--main {
    margin-top: 22px;
}
