<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="PlayerHud.uss" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="hotbar-container" class="hotbar-container" picking-mode="Ignore" />

        <ui:VisualElement name="health-bar" class="health-bar" picking-mode="Ignore">
            <ui:VisualElement class="health-bar__groove" picking-mode="Ignore">
                <ui:VisualElement name="health-bar-fill" class="health-bar__fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="food-container" class="food-container" picking-mode="Ignore" />

        <ui:VisualElement name="day-sign" class="day-sign" picking-mode="Ignore">
            <ui:Label name="clock-label" class="clock-label" picking-mode="Ignore" />
            <ui:VisualElement name="weather-icon" class="weather-icon" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:Label name="interact-prompt" class="interact-prompt" picking-mode="Ignore" />

        <ui:VisualElement name="boss-bar" class="boss-bar boss-bar--hidden" picking-mode="Ignore">
            <ui:Label name="boss-bar-name" class="boss-bar__name" picking-mode="Ignore" />
            <ui:VisualElement class="boss-bar__groove" picking-mode="Ignore">
                <ui:VisualElement name="boss-bar-fill" class="boss-bar__fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="omen-message" class="omen-message" picking-mode="Ignore" />

        <ui:VisualElement name="stamina-bar" class="stamina-bar" picking-mode="Ignore">
            <ui:VisualElement class="stamina-bar__groove" picking-mode="Ignore">
                <ui:VisualElement name="stamina-bar-fill" class="stamina-bar__fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="crosshair" class="crosshair" picking-mode="Ignore">
            <ui:VisualElement name="crosshair-ring" class="crosshair-ring crosshair--neutral" picking-mode="Ignore" />
            <ui:VisualElement name="crosshair-dot" class="crosshair-dot" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
