<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="PlayerHud.uss" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="hotbar-container" class="hotbar-container" />

        <ui:VisualElement name="health-bar" class="health-bar">
            <ui:VisualElement name="health-bar-fill" class="health-bar__fill" />
        </ui:VisualElement>

        <ui:VisualElement name="stamina-bar" class="stamina-bar">
            <ui:VisualElement name="stamina-bar-fill" class="stamina-bar__fill" />
        </ui:VisualElement>

        <ui:VisualElement name="crosshair" class="crosshair" picking-mode="Ignore">
            <ui:VisualElement name="crosshair-ring" class="crosshair-ring crosshair--neutral" picking-mode="Ignore" />
            <ui:VisualElement name="crosshair-dot" class="crosshair-dot" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
